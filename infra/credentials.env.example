# ============================================================================
# SIDECI — Local Deployment Credentials Template (SAFE PLACEHOLDERS ONLY)
# ============================================================================
# Cara pakai:
#   1. Salin file ini menjadi `infra/credentials.env` (otomatis di-abaikan Git).
#   2. Isi hanya kredensial yang benar-benar diperlukan.
#   3. JANGAN PERNAH meng-commit `infra/credentials.env` ke repositori Git!
# ============================================================================

# Path SSH Private Key lokal untuk koneksi ke VPS
VPS_SSH_KEY_PATH=~/.ssh/id_ed25519

# Koneksi PostgreSQL Produksi & Staging (di dalam jaringan Docker VPS)
DATABASE_URL_PROD=postgres://postgres:<db-password>@postgres-server:5432/sideci_prod?sslmode=disable
DATABASE_URL_STAGING=postgres://postgres:<db-password>@postgres-server:5432/sideci_staging?sslmode=disable

# Kunci Penandatanganan JWT (minimal 32 karakter acak kriptografis, berbeda tiap env)
JWT_SECRET_KEY_PROD=<generate-64-char-random-hex-prod>
JWT_SECRET_KEY_STAGING=<generate-64-char-random-hex-staging>

# Private Object Storage (MinIO / Cloudflare R2 / S3) untuk PDF Surat & Lampiran Warga
STORAGE_ENDPOINT=https://<s3-or-r2-endpoint>
STORAGE_BUCKET=sideci-private-docs
STORAGE_ACCESS_KEY=<storage-access-key>
STORAGE_SECRET_KEY=<storage-secret-key>

# Opsional: Cloudflare API Token (jika mengelola DNS wildcard/custom domain otomatis)
CLOUDFLARE_API_TOKEN=<your-cloudflare-api-token>
