APP_ENV=development
HTTP_PORT=8080
DATABASE_URL=postgres://sideci:sideci_local_dev_only@localhost:5432/sideci_dev?sslmode=disable
JWT_SECRET_KEY=change-me-in-local-dev-minimum-32-chars
ALLOWED_ORIGINS=http://localhost:3000,http://ringdikit.localhost:3000
DEFAULT_TENANT_SLUG=ringdikit
MIGRATIONS_DIR=migrations
AUTO_MIGRATE=true

# Superadmin awal (hanya dibuat bila tabel users kosong)
BOOTSTRAP_SUPERADMIN_USERNAME=superadmin
BOOTSTRAP_SUPERADMIN_PASSWORD=ganti-dengan-sandi-kuat-minimal-10
