# ============================================================================
# SIDECI — Local Docker Compose Environment Variables (SAFE TEMPLATE)
# Copy ke .env untuk pengembangan lokal. Jangan pernah commit nilai rahasia produksi!
# ============================================================================

POSTGRES_USER=sideci
POSTGRES_PASSWORD=sideci_local_dev_only
POSTGRES_DB=sideci_dev
POSTGRES_PORT=5432

BACKEND_PORT=8080
FRONTEND_PORT=3000
JWT_SECRET_KEY=change-me-in-local-dev-minimum-32-chars
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_DEFAULT_VILLAGE_SLUG=ringdikit

# Superadmin awal (dibuat otomatis HANYA bila tabel users kosong). Ganti sebelum dipakai!
BOOTSTRAP_SUPERADMIN_USERNAME=superadmin
BOOTSTRAP_SUPERADMIN_PASSWORD=ganti-dengan-sandi-kuat-minimal-10
